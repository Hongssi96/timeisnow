# Local examples only. Copy to .env and fill issued values; never commit .env.
POSTGRES_DB=timeisnow
POSTGRES_USER=timeisnow
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# JSON request logs on stdout: INFO (default), WARNING, or ERROR.
LOG_LEVEL=INFO

# Member auth: same-origin cookie + CSRF, no email delivery.
AUTH_ENV=development
AUTH_PUBLIC_ORIGIN=http://127.0.0.1:5173
# Independent random server secret (at least 32 characters). Never commit .env.
AUTH_RATE_LIMIT_SECRET=

# Provider keys stay on the backend. Health does not call providers.
KAKAO_REST_API_KEY=
KAKAO_JAVASCRIPT_KEY=
# Public portal Decoding key. Subway uses its separate issued key.
DATA_GO_KR_SERVICE_KEY=
SEOUL_SUBWAY_API_KEY=

# Fill the approved base URL including /v1; this URL is a placeholder.
OPENAI_BASE_URL=https://your-approved-ai-server.example/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
